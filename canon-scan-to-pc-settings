#!/usr/bin/env python3
"""Settings window for canon-scan-to-pc (GTK 3).

Runs only while it's open: it edits ~/.config/canon-scan-to-pc/config.ini, restarts the
background service, and shows its status. Everything printer-related is done by running
the canon-scan-to-pc program itself (--status --json, --discover, --scan-now).
"""
import configparser
import json
import os
import shutil
import subprocess
import sys
import tempfile
import threading

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

APP = "canon-scan-to-pc"
SERVICE = "canon-scan-to-pc"
CONFIG_PATH = os.path.expanduser("~/.config/canon-scan-to-pc/config.ini")


def program():
    """The canon-scan-to-pc program: next to this file, or on PATH."""
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), APP)
    return here if os.path.exists(here) else shutil.which(APP) or APP


def run_program(*args, timeout=120):
    p = subprocess.run([sys.executable, "-I", program(), *args], capture_output=True,
                       text=True, timeout=timeout)
    return p.returncode, p.stdout, p.stderr


def systemctl(*args):
    try:
        p = subprocess.run(["systemctl", "--user", *args, SERVICE], capture_output=True,
                           text=True, timeout=30)
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, str(e)


# Choices shown in the window -> values in config.ini
FORMATS = [("pdf", "PDF (all pages in one file)"), ("png", "PNG (one file per page)"),
           ("jpeg", "JPEG (one file per page)")]
RESOLUTIONS = [("75", "75 dpi (draft)"), ("150", "150 dpi"), ("300", "300 dpi (documents)"),
               ("600", "600 dpi (photos, slow)")]
PAPERS = [("letter", "Letter (8.5 × 11 in)"), ("legal", "Legal (8.5 × 14 in)"),
          ("a4", "A4 (210 × 297 mm)"), ("full", "Whole scan area")]
SOURCES = [("auto", "Automatic (feeder if loaded, else glass)"), ("flatbed", "Glass"),
           ("adf", "Document feeder"), ("adf-duplex", "Document feeder, both sides")]
BW_MODES = [("Gray", "Grayscale (keeps signatures and photos readable)"),
            ("Lineart", "Black and white only (smallest files)")]

TEMPLATE = """\
# canon-scan-to-pc settings (written by the settings window; comments are rewritten)
# After editing by hand:  systemctl --user restart canon-scan-to-pc

[printer]
# The printer's IP address or host name; empty = find it on the network automatically
host = {host}
# The name shown in the printer's Scan > Computer list (ASCII, at most 15 characters);
# empty = this computer's host name
name = {name}

[scan]
output_dir = {output_dir}
# pdf, png or jpeg
format = {format}
# Used for color choices that aren't listed in [codes]: Color, Gray or Lineart
mode = {mode}
# 75, 150, 300 or 600
resolution = {resolution}
# auto, flatbed, adf or adf-duplex
source = {source}
# letter, legal, a4 or full
paper = {paper}
notify = {notify}

# The color choice made on the printer's panel arrives as a code byte.
[codes]
{codes}
"""


def load_config():
    cfg = configparser.ConfigParser()
    cfg.read_dict({
        "printer": {"host": "", "name": ""},
        "scan": {"output_dir": "~/Scans", "format": "pdf", "mode": "Color", "resolution": "300",
                 "source": "auto", "paper": "letter", "notify": "yes"},
        "codes": {"01": "Color", "02": "Gray"},
    })
    cfg.read(CONFIG_PATH)
    return cfg


def write_config(path, values, codes):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    text = TEMPLATE.format(codes="\n".join(f"{k} = {v}" for k, v in codes.items()), **values)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def tilde(path):
    """~/Scans rather than /home/<user>/Scans in the config file."""
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + os.sep) else path


def combo(choices, current):
    box = Gtk.ComboBoxText()
    for value, label in choices:
        box.append(value, label)
    if not box.set_active_id(current):
        box.set_active(0)
    return box


class Window(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Canon Scan to PC")
        self.set_default_size(560, -1)
        self.set_icon_name("scanner")
        self.cfg = load_config()

        header = Gtk.HeaderBar(title="Canon Scan to PC", show_close_button=True)
        self.set_titlebar(header)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=14)
        self.add(outer)

        # --- status
        frame = Gtk.Frame(label=" Status ")
        sbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=8)
        frame.add(sbox)
        self.status_label = Gtk.Label(xalign=0, wrap=True, selectable=True)
        self.status_label.set_text("Checking…")
        sbox.pack_start(self.status_label, False, False, 0)
        last = Gtk.Box(spacing=6)
        self.last_label = Gtk.Label(xalign=0, wrap=True)
        self.open_button = Gtk.Button(label="Open")
        self.folder_button = Gtk.Button(label="Show in folder")
        self.open_button.connect("clicked", lambda *_: self.open_last(False))
        self.folder_button.connect("clicked", lambda *_: self.open_last(True))
        last.pack_start(self.last_label, True, True, 0)
        last.pack_end(self.folder_button, False, False, 0)
        last.pack_end(self.open_button, False, False, 0)
        sbox.pack_start(last, False, False, 0)
        outer.pack_start(frame, False, False, 0)

        # --- settings
        grid = Gtk.Grid(column_spacing=12, row_spacing=6)
        outer.pack_start(grid, False, False, 0)
        row = 0

        def add(label, widget, hint=None):
            nonlocal row
            lab = Gtk.Label(label=label, xalign=1)
            grid.attach(lab, 0, row, 1, 1)
            widget.set_hexpand(True)
            grid.attach(widget, 1, row, 1, 1)
            row += 1
            if hint:                      # tooltips keep the window short enough for 768-px screens
                lab.set_tooltip_text(hint)
                widget.set_tooltip_text(hint)

        p = self.cfg["printer"]
        hostbox = Gtk.Box(spacing=6)
        self.host = Gtk.ComboBoxText.new_with_entry()
        self.host.get_child().set_placeholder_text("Automatic (find it on the network)")
        self.host.get_child().set_text(p.get("host", ""))
        self.find_button = Gtk.Button(label="Find printers")
        self.find_button.connect("clicked", self.on_find)
        hostbox.pack_start(self.host, True, True, 0)
        hostbox.pack_start(self.find_button, False, False, 0)
        add("Printer", hostbox, "Leave empty to find it automatically, or pick it after Find printers.")

        self.name = Gtk.Entry(max_length=15, text=p.get("name", ""))
        self.name.set_placeholder_text("This computer's name")
        self.name.connect("changed", self.on_name_changed)
        add("Name on the printer", self.name, "Shown in the printer's Scan → Computer list. Up to 15 letters, digits or dashes.")

        s = self.cfg["scan"]
        self.folder = Gtk.FileChooserButton(title="Save scans to", action=Gtk.FileChooserAction.SELECT_FOLDER)
        out = os.path.expanduser(s.get("output_dir", "~/Scans"))
        os.makedirs(out, exist_ok=True)
        self.folder.set_filename(out)
        add("Save scans to", self.folder)

        self.format = combo(FORMATS, s.get("format", "pdf"))
        add("File format", self.format)
        self.resolution = combo(RESOLUTIONS, s.get("resolution", "300"))
        add("Resolution", self.resolution)
        self.paper = combo(PAPERS, s.get("paper", "letter"))
        add("Paper size", self.paper)
        self.source = combo(SOURCES, s.get("source", "auto"))
        add("Scan from", self.source)
        self.bw = combo(BW_MODES, self.cfg["codes"].get("02", "Gray"))
        add("“Black & White” gives", self.bw)

        self.notify = Gtk.Switch(halign=Gtk.Align.START)
        try:
            self.notify.set_active(s.getboolean("notify", True))
        except ValueError:
            self.notify.set_active(True)
        add("Notifications", self.notify)

        self.autostart = Gtk.Switch(halign=Gtk.Align.START)
        self.autostart.set_active(systemctl("is-enabled")[0] == 0)
        add("Start at login", self.autostart, "Keeps this computer in the printer's list whenever you're logged in.")

        # --- buttons
        buttons = Gtk.Box(spacing=6)
        self.message = Gtk.Label(xalign=0, wrap=True)
        self.test_button = Gtk.Button(label="Test scan")
        self.test_button.set_tooltip_text("Scan once now with the settings above (put something on the glass)")
        self.test_button.connect("clicked", self.on_test)
        self.save_button = Gtk.Button(label="Save")
        self.save_button.get_style_context().add_class("suggested-action")
        self.save_button.connect("clicked", self.on_save)
        buttons.pack_start(self.message, True, True, 0)
        buttons.pack_end(self.save_button, False, False, 0)
        buttons.pack_end(self.test_button, False, False, 0)
        outer.pack_start(buttons, False, False, 0)

        self.last_files = []
        self.refresh_status()

    # ---------------------------------------------------------------- helpers

    def in_background(self, work, done):
        """Run work() in a thread, then done(result) in the GTK main loop."""
        def worker():
            try:
                result = work()
            except Exception as e:          # report, don't crash the window
                result = e
            GLib.idle_add(done, result)
        threading.Thread(target=worker, daemon=True).start()

    def values(self):
        name = "".join(c for c in self.name.get_text().upper() if c.isascii() and (c.isalnum() or c == "-"))
        return {
            "host": self.host.get_child().get_text().split(" ")[0].strip(),
            "name": name[:15],
            "output_dir": tilde(self.folder.get_filename() or os.path.expanduser("~/Scans")),
            "format": self.format.get_active_id(),
            "mode": self.cfg["scan"].get("mode", "Color"),
            "resolution": self.resolution.get_active_id(),
            "source": self.source.get_active_id(),
            "paper": self.paper.get_active_id(),
            "notify": "yes" if self.notify.get_active() else "no",
        }

    def codes(self):
        codes = dict(self.cfg["codes"])
        codes.setdefault("01", "Color")
        codes["02"] = self.bw.get_active_id()
        return codes

    def on_name_changed(self, entry):
        text = entry.get_text()
        clean = "".join(c for c in text.upper() if c.isascii() and (c.isalnum() or c == "-"))
        if clean != text:
            pos = entry.get_position()
            entry.set_text(clean)
            entry.set_position(min(pos, len(clean)))

    # ---------------------------------------------------------------- status

    def refresh_status(self):
        def work():
            code, out, err = run_program("--status", "--json", timeout=30)
            return json.loads(out) if code == 0 else RuntimeError(err.strip() or "no status")
        self.in_background(work, self.show_status)

    def show_status(self, st):
        if isinstance(st, Exception):
            self.status_label.set_text(f"Couldn't read the status: {st}")
            return False
        if st.get("service") == "active" and st.get("registered_with"):
            model = st.get("printer_model") or "the printer"
            text = f"✔ Running. This computer is listed as {st['name']} on {model} ({st['registered_with']})."
            if not st.get("printer_reachable"):
                text += "\nThe printer isn't answering right now (off or asleep?)."
        elif st.get("service") == "active":
            text = "Running, but not registered with a printer yet. Is the printer on and on this network?"
        else:
            text = "Not running. Turn on Start at login and press Save."
        self.status_label.set_text(text)
        ls = st.get("last_scan")
        self.last_files = (ls or {}).get("files") or []
        if ls and ls.get("error"):
            self.last_label.set_text(f"Last scan ({ls['time']}) failed: {ls['error']}")
        elif ls:
            first = os.path.basename(self.last_files[0]) if self.last_files else ""
            self.last_label.set_text(f"Last scan: {ls['time']}, {ls.get('pages')} page(s): {first}")
        else:
            self.last_label.set_text("No scans yet.")
        have = bool(self.last_files) and os.path.exists(self.last_files[0])
        self.open_button.set_sensitive(have)
        self.folder_button.set_sensitive(have)
        return False

    def open_last(self, folder):
        path = self.last_files[0]
        if folder:
            run = [sys.executable, "-I", "-c",
                   "import sys; from importlib.machinery import SourceFileLoader as L; "
                   "L('m', sys.argv[1]).load_module().show_in_folder(sys.argv[2])", program(), path]
            subprocess.Popen(run)
        else:
            subprocess.Popen(["xdg-open", path])

    # ---------------------------------------------------------------- actions

    def on_find(self, button):
        button.set_sensitive(False)
        self.message.set_text("Looking for Canon scanners…")

        def work():
            return run_program("--discover", timeout=60)

        def done(result):
            button.set_sensitive(True)
            if isinstance(result, Exception):
                self.message.set_text(f"Search failed: {result}")
                return False
            code, out, err = result
            found = [line.split("\t") for line in out.splitlines() if "\t" in line]
            self.host.remove_all()
            for ip, model in found:
                self.host.append_text(f"{ip}  ({model})")
            if found:
                self.host.set_active(0)
                self.message.set_text(f"Found {len(found)} Canon scanner(s).")
            else:
                self.message.set_text(err.strip() or "No Canon scanners found.")
            return False
        self.in_background(work, done)

    def on_save(self, button):
        try:
            write_config(CONFIG_PATH, self.values(), self.codes())
        except OSError as e:
            self.message.set_text(f"Couldn't save: {e}")
            return
        self.cfg = load_config()
        if self.autostart.get_active():
            code, out = systemctl("enable")
            if code == 0:
                code, out = systemctl("restart")
            self.message.set_text("Saved. The service restarted with the new settings." if code == 0
                                  else f"Saved, but the service couldn't start: {out}")
        else:
            systemctl("disable")
            systemctl("stop")
            self.message.set_text("Saved. The service is stopped and won't start at login.")
        GLib.timeout_add_seconds(3, lambda: self.refresh_status() and False)

    def on_test(self, button):
        button.set_sensitive(False)
        self.message.set_text("Scanning…")
        values, codes = self.values(), self.codes()

        def work():
            with tempfile.TemporaryDirectory() as tmp:
                path = os.path.join(tmp, "config.ini")
                write_config(path, values, codes)
                return run_program("-c", path, "--scan-now", timeout=900)

        def done(result):
            button.set_sensitive(True)
            if isinstance(result, Exception):
                self.message.set_text(f"Test scan failed: {result}")
            else:
                code, out, err = result
                if code == 0:
                    self.message.set_text(out.strip().replace("saved", "Saved", 1))
                    saved = out.split(": ", 1)[-1].split(", ")
                    if saved and os.path.exists(saved[0].strip()):
                        subprocess.Popen(["xdg-open", saved[0].strip()])
                else:
                    lines = [l for l in err.strip().splitlines() if l.strip()]
                    self.message.set_text("Test scan failed: " + (lines[-1] if lines else f"exit {code}"))
            return False
        self.in_background(work, done)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.anthonytheinventor.CanonScanToPC")

    def do_activate(self):
        win = self.get_active_window() or Window(self)
        win.show_all()
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
